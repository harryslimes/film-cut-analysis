# Extra folders to scan for movies, in addition to data/movies.
# Comma- or newline-separated absolute paths. Copy this file to .env and edit.
# Restart label_server.py after changing (config is read once at startup).
MOVIE_DIRS=/mnt/films,/media/movies

# Detector used when processing a movie into a base run. Default: transnet-cpu
# (CPU decode + GPU inference — fastest for 720p/1080p). Use transnet-cuda only
# for 4K / 10-bit HEVC sources where the NVDEC hardware decoder actually pays off.
PROCESS_DETECTOR=transnet-cpu
